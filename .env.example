# DocuMate Environment Configuration
# Copy this file to .env and fill in your actual values

# OpenAI API Configuration
# Get your API key from: https://platform.openai.com/api-keys
OPENAI_API_KEY=your-openai-api-key-here

# Database Configuration (for PostgreSQL)
POSTGRES_USER=documate_user
POSTGRES_PASSWORD=your_secure_password_here
POSTGRES_DB=documate

# Flask Security
# Generate secure keys with: python -c "import secrets; print(secrets.token_urlsafe(32))"
FLASK_SECRET_KEY=your-flask-secret-key-here
JWT_SECRET_KEY=your-jwt-secret-key-here

# Backend API Configuration
FLASK_APP=setup.py
FLASK_ENV=development

# Frontend Configuration
REACT_APP_API_URL=http://localhost:5000

# Optional: LangSmith Tracing (for advanced observability)
# Uncomment and fill in if you want LangSmith tracing
# LANGCHAIN_TRACING_V2=true
# LANGCHAIN_API_KEY=your-langsmith-api-key-here
# LANGCHAIN_PROJECT=documate
# LANGCHAIN_ENDPOINT=https://api.smith.langchain.com
